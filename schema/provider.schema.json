{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michelabboud/ai-model-registry/schema/provider.schema.json",
  "title": "AI model registry provider file",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "provider"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "base_url": {
      "type": "string",
      "pattern": "^https://(?:[A-Za-z0-9._~!$&'()*+,;=:%/\\[\\]-]|\\{region\\}|\\{project\\})+$"
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "anthropic_messages",
          "openai_chat",
          "openai_responses",
          "gemini_generate",
          "gemini_interactions",
          "bedrock_converse",
          "vertex_anthropic",
          "vertex_gemini"
        ]
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "auth": {
      "type": "string",
      "enum": [
        "x_api_key",
        "bearer",
        "google_api_key",
        "aws_sigv4",
        "gcp_oauth"
      ]
    },
    "docs_url": {
      "type": "string",
      "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500
    },
    "verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "display_name",
    "base_url",
    "protocols",
    "auth",
    "docs_url",
    "verified",
    "sources"
  ],
  "additionalProperties": false
}
