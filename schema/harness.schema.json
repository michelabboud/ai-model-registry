{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michelabboud/ai-model-registry/schema/harness.schema.json",
  "title": "AI model registry harness file",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "harness"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "command": {
      "$ref": "#/$defs/bare_command"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bare_command"
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "adapter": {
      "type": "string",
      "enum": [
        "claude_env",
        "codex_config",
        "opencode_v1",
        "opencode_v2",
        "env_generic",
        "config_snippet",
        "detect_only"
      ]
    },
    "config_style": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?!LD_|DYLD_|GIT_|SSH_)[A-Z_][A-Z0-9_]{0,63}$",
            "not": {
              "enum": [
                "PATH",
                "HOME",
                "SHELL",
                "IFS",
                "ENV",
                "BASH_ENV",
                "PS4",
                "NODE_OPTIONS",
                "NODE_PATH",
                "PYTHONPATH",
                "PYTHONSTARTUP",
                "PERL5OPT",
                "PERL5LIB",
                "RUBYOPT",
                "RUBYLIB"
              ]
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "base_url",
              "api_key",
              "auth_token",
              "model",
              "provider",
              "flag"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "role",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "profile_flag": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^--?[a-z][a-z0-9-]{0,39}$"
    },
    "model_flag": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^--?[a-z][a-z0-9-]{0,39}$"
    },
    "version_probe": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "--version",
          "-v",
          "version"
        ]
      },
      "minItems": 0,
      "maxItems": 2
    },
    "version_match": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "major_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "major_pattern"
      ],
      "additionalProperties": false
    },
    "docs_url": {
      "type": "string",
      "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500
    },
    "verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "display_name",
    "command",
    "aliases",
    "adapter",
    "config_style",
    "env",
    "profile_flag",
    "model_flag",
    "version_probe",
    "version_match",
    "docs_url",
    "icon",
    "verified",
    "sources"
  ],
  "additionalProperties": false,
  "$defs": {
    "bare_command": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    }
  }
}
