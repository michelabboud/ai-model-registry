{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michelabboud/ai-model-registry/schema/models.schema.json",
  "title": "AI model registry models file",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "models"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      },
      "minItems": 1,
      "maxItems": 500
    }
  },
  "required": [
    "schema_version",
    "kind",
    "provider",
    "models"
  ],
  "additionalProperties": false,
  "$defs": {
    "price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "USD per million tokens. Null means unpublished or unknown; zero means free."
    },
    "pricing": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/price"
        },
        "output": {
          "$ref": "#/$defs/price"
        },
        "cache_read": {
          "$ref": "#/$defs/price"
        },
        "batch_discount_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "long_context": {
          "type": "object",
          "properties": {
            "threshold_tokens": {
              "type": "integer",
              "minimum": 1,
              "description": "Long-context prices apply when the prompt's input tokens are strictly greater than threshold_tokens."
            },
            "input": {
              "$ref": "#/$defs/price"
            },
            "output": {
              "$ref": "#/$defs/price"
            },
            "cache_read": {
              "$ref": "#/$defs/price"
            },
            "cache_writes": {
              "$ref": "#/$defs/cache_writes"
            },
            "cache_storage_per_mtok_hour": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "USD per million cached tokens per hour. Null means unpublished or unknown; zero means free."
            }
          },
          "required": [
            "threshold_tokens",
            "input",
            "output",
            "cache_read",
            "cache_writes"
          ],
          "additionalProperties": false
        },
        "cache_writes": {
          "$ref": "#/$defs/cache_writes"
        },
        "cache_storage_per_mtok_hour": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "USD per million cached tokens per hour. Null means unpublished or unknown; zero means free."
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_writes",
        "batch_discount_percent"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "ga",
            "preview",
            "deprecated"
          ]
        },
        "shutdown": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "input_modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "pdf"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "not": {
            "items": {
              "enum": [
                "image",
                "audio",
                "video",
                "pdf"
              ]
            }
          }
        },
        "probe": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "verified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s/@?#]+(?:[/?#][^\\s]*)?$"
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "display_name",
        "status",
        "tier",
        "context_window",
        "max_output_tokens",
        "input_modalities",
        "probe",
        "default",
        "pricing",
        "verified",
        "sources"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "shutdown"
        ]
      },
      "not": {
        "properties": {
          "status": {
            "enum": [
              "ga",
              "preview"
            ]
          }
        },
        "required": [
          "status",
          "shutdown"
        ]
      }
    },
    "cache_writes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ttl": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,3}[mh]$"
          },
          "price": {
            "$ref": "#/$defs/price"
          }
        },
        "required": [
          "ttl",
          "price"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6,
      "description": "Per-token cache-write rates, USD per million tokens. TTLs must be unique; empty means no published per-token write rate."
    }
  }
}
